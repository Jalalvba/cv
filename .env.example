MONGODB_URI=your_mongodb_atlas_connection_string_here
GOOGLE_SERVICE_ACCOUNT_KEY_B64=your_base64_encoded_service_account_json_here
GOOGLE_DRIVE_TEST_FOLDER_ID=your_folder_id_here
GOOGLE_SHEETS_TEST_SPREADSHEET_ID=your_spreadsheet_id_here
ADMIN_PASSWORD=your_admin_password_here
# iron-session sealed-cookie secret — must be at least 32 characters.
# Generate a local value with: openssl rand -hex 32
IRON_SESSION_SECRET=your_32_char_minimum_random_secret_here
# Google Gemini API key — used by POST /api/admin/generate-positioning to turn a
# job offer into an FR/EN PositioningDoc pair. Create one at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here
# Cost tracking (lib/gemini-cost-tracker.ts). USD_TO_MAD_RATE defaults to 9.4 if unset.
USD_TO_MAD_RATE=9.4
# Starting prepaid credit in USD. Remaining credit is derived as this minus all
# paid-tier spend recorded in MongoDB — so raise this value when you top up.
GEMINI_PREPAID_USD_BALANCE=0
# Shared secret for GET /api/track/stats (email open-tracking). Generate with: openssl rand -hex 32
TRACKING_STATS_SECRET=your_tracking_stats_secret_here
